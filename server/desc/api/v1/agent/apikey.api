syntax = "v1"

info (
	title:      "Agent API Key"
	desc:       "Agent 账户密钥管理"
	author:     "agentrazor"
	version:    "v1"
	go_package: "v1/agent/apikey"
)

type (
	ApiKey {
		Id        string `json:"id"`
		KeyHint   string `json:"keyHint"`
		CreatedAt string `json:"createdAt"`
	}
	ListResponse {
		Keys []ApiKey `json:"keys"`
	}
	CreateResponse {
		ApiKey
		Key string `json:"key"`
	}
	DeleteRequest {
		Id string `path:"id" validate:"required"`
	}
	DeleteResponse  {}
)

@server (
	prefix:          /api/v1
	group:           v1/agent/apikey
	compact_handler: true
	middleware:      AuthxAuthenticate
)
service server {
	@doc "列出当前账户的 Agent API 密钥"
	@handler List
	get /agent/api-keys returns (ListResponse)

	@doc "生成 Agent API 密钥，每个账户最多三个"
	@handler Create
	post /agent/api-keys returns (CreateResponse)

	@doc "删除 Agent API 密钥"
	@handler Delete
	delete /agent/api-keys/:id (DeleteRequest) returns (DeleteResponse)
}

