syntax = "v1"

info (
	go_package: "v1/manage/agent"
)

type TokenQuotaGlobal {
	FiveHourLimitTokens int64 `json:"fiveHourLimitTokens"`
	SevenDayLimitTokens int64 `json:"sevenDayLimitTokens"`
}

type GetTokenQuotaGlobalRequest {}

type GetTokenQuotaGlobalResponse {
	Quota TokenQuotaGlobal `json:"quota"`
}

type SaveTokenQuotaGlobalRequest {
	FiveHourLimitTokens int64 `json:"fiveHourLimitTokens" validate:"required,gt=0"`
	SevenDayLimitTokens int64 `json:"sevenDayLimitTokens" validate:"required,gt=0"`
}

type SaveTokenQuotaGlobalResponse {}

type TokenQuotaUser {
	UserUuid               string  `json:"userUuid"`
	Configured             bool    `json:"configured"`
	Enabled                bool    `json:"enabled"`
	FiveHourDisabled       bool    `json:"fiveHourDisabled"`
	FiveHourLimitTokens    *int64  `json:"fiveHourLimitTokens,omitempty"`
	SevenDayLimitTokens    *int64  `json:"sevenDayLimitTokens,omitempty"`
	EffectiveFiveHourLimit *int64  `json:"effectiveFiveHourLimit,omitempty"`
	EffectiveSevenDayLimit int64   `json:"effectiveSevenDayLimit"`
	FiveHourUsedTokens     int64   `json:"fiveHourUsedTokens"`
	SevenDayUsedTokens     int64   `json:"sevenDayUsedTokens"`
	FiveHourResetAt        *string `json:"fiveHourResetAt,omitempty"`
	SevenDayResetAt        *string `json:"sevenDayResetAt,omitempty"`
	QuotaResetAt           *string `json:"quotaResetAt,omitempty"`
}

type GetUserTokenQuotaRequest {
	UserUuid string `path:"user_uuid" validate:"required"`
}

type GetUserTokenQuotaResponse {
	Quota TokenQuotaUser `json:"quota"`
}

type SaveUserTokenQuotaRequest {
	UserUuid            string `path:"user_uuid" validate:"required"`
	Enabled             bool   `json:"enabled"`
	FiveHourDisabled    bool   `json:"fiveHourDisabled"`
	FiveHourLimitTokens *int64 `json:"fiveHourLimitTokens,optional" validate:"omitempty,gt=0"`
	SevenDayLimitTokens *int64 `json:"sevenDayLimitTokens,optional" validate:"omitempty,gt=0"`
}

type SaveUserTokenQuotaResponse {}

type DeleteUserTokenQuotaRequest {
	UserUuid string `path:"user_uuid" validate:"required"`
}

type DeleteUserTokenQuotaResponse {}

type ResetUserTokenQuotaRequest {
	UserUuid string `path:"user_uuid" validate:"required"`
}

type ResetUserTokenQuotaResponse {}

type Skill {
	Name string `json:"name"`
}

type SkillFile {
	Name     string      `json:"name"`
	Path     string      `json:"path"`
	Type     string      `json:"type,options=file|directory"`
	Children []SkillFile `json:"children,optional"`
}

type ListSkillsRequest {}

type ListSkillsResponse {
	Skills []Skill `json:"skills"`
}

type SkillDetailRequest {
	SkillName string `path:"skill_name" validate:"required"`
	File      string `form:"file,optional"`
}

type SkillDetailResponse {
	Skill       Skill       `json:"skill"`
	Files       []SkillFile `json:"files"`
	CurrentFile string      `json:"currentFile"`
	Content     string      `json:"content"`
}

type DeleteSkillRequest {
	SkillName string `path:"skill_name" validate:"required"`
}

type DeleteSkillResponse {}

type UpdateSkillFileRequest {
	SkillName string `path:"skill_name" validate:"required"`
	File      string `json:"file" validate:"required"`
	Content   string `json:"content"`
}

type UpdateSkillFileResponse {}

type UploadSkillRequest {}

type UploadSkillResponse {
	Name string `json:"name"`
}

type ProviderModel {
	Id                     string   `json:"id"`
	Name                   string   `json:"name"`
	DefaultReasoningEffort string   `json:"defaultReasoningEffort,optional"`
	ReasoningEfforts       []string `json:"reasoningEfforts"`
}

type ModelProvider {
	Id        string          `json:"id"`
	Name      string          `json:"name"`
	BaseUrl   string          `json:"baseUrl,optional"`
	WireApi   string          `json:"wireApi"`
	HasApiKey bool            `json:"hasApiKey"`
	Models    []ProviderModel `json:"models"`
}

type AccountStatus {
	AuthMode string `json:"authMode,optional"`
	Email    string `json:"email,optional"`
	PlanType string `json:"planType,optional"`
	LoggedIn bool   `json:"loggedIn"`
}

type GetAccountStatusRequest {}

type GetAccountStatusResponse {
	Account AccountStatus `json:"account"`
}

type GetSettingsRequest {}

type GetSettingsResponse {
	ActiveProvider  string          `json:"activeProvider"`
	Model           string          `json:"model"`
	ReasoningEffort string          `json:"reasoningEffort"`
	Providers       []ModelProvider `json:"providers"`
	Account         AccountStatus   `json:"account"`
	Runtime         RuntimeStatus   `json:"runtime"`
}

type SaveSelectionRequest {
	ProviderId      string `json:"providerId" validate:"required"`
	Model           string `json:"model" validate:"required"`
	ReasoningEffort string `json:"reasoningEffort,optional"`
}

type SaveSelectionResponse {}

type SaveProviderApiKeyRequest {
	ProviderId string `json:"providerId" validate:"required"`
	ApiKey     string `json:"apiKey" validate:"required"`
}

type SaveProviderApiKeyResponse {
	HasApiKey bool `json:"hasApiKey"`
}

type LoginApiKeyRequest {
	ApiKey string `json:"apiKey" validate:"required"`
}

type LoginApiKeyResponse {
	Account AccountStatus `json:"account"`
}

type StartChatGPTLoginRequest {}

type StartChatGPTLoginResponse {
	LoginId         string `json:"loginId"`
	VerificationUrl string `json:"verificationUrl"`
	UserCode        string `json:"userCode"`
	ExpiresIn       int64  `json:"expiresIn,optional"`
}

type LogoutRequest {}

type LogoutResponse {}

type RuntimeStatus {
	Running bool `json:"running"`
}

type HomeOverviewRequest {}

type HomeOverviewResponse {
	AgentRunning   bool   `json:"agentRunning"`
	ActiveProvider string `json:"activeProvider"`
	Model          string `json:"model"`
	ModelName      string `json:"modelName"`
	TotalTokens    int64  `json:"totalTokens"`
	SkillCount     int64  `json:"skillCount"`
}

@server (
	prefix:          /api/v1
	group:           v1/manage/agent
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler ListSkills
	get /manage/agent/skills (ListSkillsRequest) returns (ListSkillsResponse)

	@handler SkillDetail
	get /manage/agent/skills/:skill_name (SkillDetailRequest) returns (SkillDetailResponse)

	@handler UploadSkill
	post /manage/agent/skills/upload (UploadSkillRequest) returns (UploadSkillResponse)

	@handler DeleteSkill
	post /manage/agent/skills/:skill_name/delete (DeleteSkillRequest) returns (DeleteSkillResponse)

	@handler UpdateSkillFile
	post /manage/agent/skills/:skill_name/file (UpdateSkillFileRequest) returns (UpdateSkillFileResponse)

	@handler GetSettings
	get /manage/agent/settings (GetSettingsRequest) returns (GetSettingsResponse)

	@handler GetAccountStatus
	get /manage/agent/auth/status (GetAccountStatusRequest) returns (GetAccountStatusResponse)

	@handler SaveSelection
	post /manage/agent/settings/selection (SaveSelectionRequest) returns (SaveSelectionResponse)

	@handler SaveProviderApiKey
	post /manage/agent/auth/provider-api-key (SaveProviderApiKeyRequest) returns (SaveProviderApiKeyResponse)

	@handler LoginApiKey
	post /manage/agent/auth/api-key (LoginApiKeyRequest) returns (LoginApiKeyResponse)

	@handler StartChatGPTLogin
	post /manage/agent/auth/chatgpt/start (StartChatGPTLoginRequest) returns (StartChatGPTLoginResponse)

	@handler Logout
	post /manage/agent/auth/logout (LogoutRequest) returns (LogoutResponse)

	@handler GetTokenQuotaGlobal
	get /manage/agent/token-quota/global (GetTokenQuotaGlobalRequest) returns (GetTokenQuotaGlobalResponse)

	@handler SaveTokenQuotaGlobal
	post /manage/agent/token-quota/global (SaveTokenQuotaGlobalRequest) returns (SaveTokenQuotaGlobalResponse)

	@handler GetUserTokenQuota
	get /manage/agent/token-quota/users/:user_uuid (GetUserTokenQuotaRequest) returns (GetUserTokenQuotaResponse)

	@handler SaveUserTokenQuota
	post /manage/agent/token-quota/users/:user_uuid (SaveUserTokenQuotaRequest) returns (SaveUserTokenQuotaResponse)

	@handler DeleteUserTokenQuota
	delete /manage/agent/token-quota/users/:user_uuid (DeleteUserTokenQuotaRequest) returns (DeleteUserTokenQuotaResponse)

	@handler ResetUserTokenQuota
	post /manage/agent/token-quota/users/:user_uuid/reset (ResetUserTokenQuotaRequest) returns (ResetUserTokenQuotaResponse)
}

@server (
	prefix:          /api/v1
	group:           v1/manage/agent
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler HomeOverview
	get /home/overview (HomeOverviewRequest) returns (HomeOverviewResponse)
}

