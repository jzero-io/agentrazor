syntax = "v1"

info (
	title:      "Conversation Group API"
	desc:       "对话分组管理接口"
	author:     "agentrazor"
	version:    "v1"
	go_package: "v1/conversation/group"
)

type (
	ConversationGroup {
		Id        string `json:"id"`
		Name      string `json:"name"`
		CreatedAt string `json:"createdAt"`
		UpdatedAt string `json:"updatedAt"`
	}
	ListResponse {
		Groups []ConversationGroup `json:"groups"`
	}
	CreateRequest {
		Name string `json:"name" validate:"required,max=40"`
	}
	PathRequest {
		GroupId string `path:"group_id" validate:"required"`
	}
	DeleteResponse  {}
	ArchiveConversationsResponse  {}
	DeleteArchivedConversationsResponse  {}
	UpdateRequest {
		GroupId string  `path:"group_id" validate:"required"`
		Name    *string `json:"name,optional" validate:"omitempty,max=40"`
	}
)

@server (
	prefix:          /api/v1
	group:           v1/conversation/group
	compact_handler: true
	jwt:             Jwt
	middleware:      Agent
)
service server {
	@handler List
	get /conversation-groups returns (ListResponse)

	@handler Create
	post /conversation-groups (CreateRequest) returns (ConversationGroup)

	@handler Update
	patch /conversation-groups/:group_id (UpdateRequest) returns (ConversationGroup)

	@handler Delete
	delete /conversation-groups/:group_id (PathRequest) returns (DeleteResponse)

	@doc "归档分组内所有对话"
	@handler ArchiveConversations
	post /conversation-groups/:group_id/archive-conversations (PathRequest) returns (ArchiveConversationsResponse)

	@doc "删除分组内所有已归档对话"
	@handler DeleteArchivedConversations
	post /conversation-groups/:group_id/delete-archived-conversations (PathRequest) returns (DeleteArchivedConversationsResponse)
}

