# Install as /etc/nginx/conf.d/agentrazor.conf. This file is included from
# nginx's http {} block. It targets the BlockRazor host network layout.
#
# Published upstreams:
#   agent: 172.19.0.1:28080
#   admin: 172.19.0.1:8443

upstream agentrazor_agent {
    server 172.19.0.1:28080;
    keepalive 16;
}

upstream agentrazor_admin {
    server 172.19.0.1:8443;
    keepalive 16;
}

server {
    listen 443 ssl;
    server_name agentrazor.blockrazor.io;
    # The application limits each attachment to 10 MB. Leave room for the
    # multipart envelope so Nginx does not reject a valid upload first.
    client_max_body_size 20m;

    ssl_certificate     /etc/nginx/ssl/agentrazor.blockrazor.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agentrazor.blockrazor.io/privkey.pem;

    # SSE must be matched before the generic location. Buffering prevents the
    # browser from receiving stream.ready and leaves the request provisional.
    location ~ ^/api/v1/agent/conversation/[^/]+/events$ {
        proxy_pass http://agentrazor_agent;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass http://agentrazor_agent;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    server_name admin.agentrazor.blockrazor.io;
    # Applies to uploads from the Agent SPA mounted at /agent-app/ as well.
    client_max_body_size 20m;

    # The supplied certificate must include both AgentRazor hostnames.
    ssl_certificate     /etc/nginx/ssl/agentrazor.blockrazor.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agentrazor.blockrazor.io/privkey.pem;

    # The embedded Agent UI on /agent-app also opens this endpoint. It must
    # bypass proxy buffering at the host Nginx as well as at the container.
    location ~ ^/api/v1/agent/conversation/[^/]+/events$ {
        proxy_pass http://agentrazor_admin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass http://agentrazor_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
